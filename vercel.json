{
    "version": 2,
    "builds": [
        {
            "src": "api/main.go",
            "use": "@vercel/go"
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/main.go"
        },
        {
            "src": "/(.*)",
            "dest": "static/$1"
        }
    ]
}